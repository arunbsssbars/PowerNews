rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify admin identity
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'arunbsssbars@gmail.com';
    }

    // 1. AI Summaries: Publicly readable for news feed, client-side writes completely denied (written by backend Admin SDK)
    match /ai_summaries/{summaryId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Power60 Training Data: Strictly restricted to Admin
    match /power60_training_data/{docId} {
      allow read, write: if isAdmin();
    }

    // 3. User Feedback & Suggestions:
    // Clients can submit feedback with validated structure; only Admin can read or manage feedback submissions
    match /feedbacks/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['content', 'timestamp']) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // 4. System Configuration (e.g. keywords):
    // Publicly readable for client classification, writable only by Admin
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Default Deny: All other collections and documents blocked by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
